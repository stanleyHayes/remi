# ── API (apps/api/.env) ──
PORT=8088
MONGODB_URI=mongodb://localhost:27019/remi
JWT_SECRET=dev-secret-change-me
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3010,http://localhost:3011,http://localhost:3012
# Seed admin credentials (used by `go run ./cmd/seed`)
SEED_ADMIN_EMAIL=admin@remi.church
SEED_ADMIN_PASSWORD=remi-admin-2026
SEED_MEMBER_OTP=260811
# Keep individual retention signals off until product, pastoral and privacy approvals are recorded.
CHMS_RETENTION_SIGNALS_ENABLED=false

# ── Third-party keys (optional in dev — services fall back to demo mode) ──
# Cloudinary: media uploads. Without these, the API returns 501 for uploads and the site uses placeholder images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Resend: transactional email. Without this, emails are logged to the API console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=REMI Church <noreply@remi.church>
# Staff inbox that receives prayer/contact/registration notifications
NOTIFY_EMAIL=pastor@remi.church
# Absolute admin URL used in account invitation emails
ADMIN_APP_URL=http://localhost:3011
# Absolute member URL used in member invitation emails
MEMBER_APP_URL=http://localhost:3012
# Arkesel V2 transactional SMS. Without a key, OTP messages are logged in development.
ARKESEL_API_KEY=
SMS_SENDER=REMI
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
PUBLIC_WEB_URL=http://localhost:3000
COMMUNICATION_WEBHOOK_SECRET=
# Paystack: online giving. Local development may use the explicit demo
# checkout; production startup requires the secret and never falls back.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── Frontends (apps/web, apps/admin, apps/member) ──
NEXT_PUBLIC_API_URL=http://localhost:8088
# Canonical public origin used for canonical URLs, sitemap, robots and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3010
# Optional Google Search Console HTML-tag verification token (token only, not the full tag).
GOOGLE_SITE_VERIFICATION=
